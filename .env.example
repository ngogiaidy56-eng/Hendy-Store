# Copy to .env for local development. Never commit the populated file.
APP_ENV=production
STORE_NAME="Hendy Store"
APP_URL=auto
APP_AUTO_DETECT_DOMAINS=true
APP_ALLOWED_HOSTS=hendystore.onrender.com,hendy-store.onrender.com,hendystore-next.onrender.com,hendystore-pages.pages.dev
APP_ALLOWED_ORIGINS=https://hendystore.onrender.com,https://hendy-store.onrender.com,https://hendystore-next.onrender.com,https://hendystore-pages.pages.dev

# Generate with: openssl rand -hex 32
APP_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dedicated PHP email/password session for /admin; never used for customer sign-in.
ADMIN_SESSION_FALLBACK_ENABLED=true

# Neon PostgreSQL pooled connection string. Keep it on the server only.
DATABASE_URL=

# Neon Managed Auth public endpoints (no credentials).
# Server-only secret for the optional Next.js Managed Auth cookie proxy.
# Generate locally: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
HENDY_API_ORIGIN=https://hendy-store.onrender.com
NEXT_PUBLIC_SITE_URL=https://hendystore-next.onrender.com
NEON_AUTH_BASE_URL=https://ep-withered-sunset-bekyloue.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-withered-sunset-bekyloue.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_PUBLIC_SIGNUP=false
ALLOW_REGISTRATION=false
GOOGLE_OAUTH_ENABLED=false

# Public catalogue Data API only.
NEON_DATA_API_URL=https://ep-withered-sunset-bekyloue.apirest.c-9.us-east-2.aws.neon.tech/Hendy_Store/rest/v1

# Private Neon Object Storage.
OBJECT_STORAGE_PROVIDER=neon
AWS_ENDPOINT_URL_S3=https://br-frosty-wildflower-bevhhzlb.storage.c-9.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=hendy-store-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_LEGACY_NEON_READ_FALLBACK=false

# Neon AI Gateway and Realtime. Model inference may require prepaid credits.
NEON_AI_GATEWAY_BASE_URL=https://br-frosty-wildflower-bevhhzlb-api.ai.c-9.us-east-2.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=
NEON_AI_MODEL=gpt-5-mini
NEON_REALTIME_URL=https://ep-withered-sunset-bekyloue.rt.c-9.us-east-2.aws.neon.tech/
NEON_REALTIME_SECRET=
NEON_STORE_FUNCTION_URL=https://br-frosty-wildflower-bevhhzlb-storeapi.compute.c-9.us-east-2.aws.neon.tech/

# Release scanning fails closed when this key is missing.
VIRUSTOTAL_API_KEY=
MAX_UPLOAD_BYTES=209715200
MAX_DIRECT_UPLOAD_BYTES=681574400

# Optional Cloudflare R2 provider. Enable only after configuring a private bucket and scoped keys.
# OBJECT_STORAGE_PROVIDER=r2
# CLOUDFLARE_ACCOUNT_ID=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_LEGACY_NEON_READ_FALLBACK=true

FORCE_SECURE_COOKIES=true
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=true
STORE_CONTACT_EMAIL=
